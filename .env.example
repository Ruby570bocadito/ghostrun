# Copy this file to .env and fill in your own key. Never commit .env.
# Meta Model API key (https://dev.meta.ai) — used by the ghost players.
MODEL_API_KEY=

# Model the ghosts play with. Options: muse-ember-1.0 (default, fast and cheap),
# muse-spark-1.3, muse-wonder-1.0.
GHOST_MODEL=muse-ember-1.0

# Reasoning effort per move: minimal | low | medium | high. Lower = faster.
GHOST_REASONING=minimal
